subset <- fromJSON("~/Library/CloudStorage/Box-Box/judits_work_keller_lab//fe_si_images/output/process_subset/subset_labl_2020_tuning.json") %>% select(image_name, pixel_length_um, pixel_area_um2)
included_mucosa_list <- fromJSON("~/Library/CloudStorage/Box-Box/judits_work_keller_lab/fe_si_papers/lymphocyte_distribution_patterns_in_feline_small_intestinal_biopsies//output/included_mucosa/included_mucosa_list.json") %>%
left_join(subset)
image_fragment_mucosa_names <- included_mucosa_list$name
mapped_ai_output_dir <- "~/Library/CloudStorage/Box-Box/judits_work_keller_lab/fe_si_models/combos/output/mapped_ai_output/"
output_dir <- "~/Library/CloudStorage/Box-Box/judits_work_keller_lab/fe_si_papers/lymphocyte_distribution_patterns_in_feline_small_intestinal_biopsies/output/lymphocyte_distribution_features/"
lymphocyte_features_summaries <- NULL
for (img_frag_muc in image_fragment_mucosa_names){
message("Processing ", img_frag_muc)
included_mucosa_info <- included_mucosa_list %>% filter(name == img_frag_muc)
pixel_length_um <- included_mucosa_info$pixel_length_um
pixel_area_um2 <- included_mucosa_info$pixel_area_um2
ai_output_path  <- paste0(mapped_ai_output_dir, img_frag_muc, "_mapped_ai_output.geojson")
ai_output <- st_read(ai_output_path, quiet = TRUE) %>% st_set_crs(0) %>%
mutate(area_px2 = st_area(geometry),
area_um2 = area_px2 * pixel_area_um2)
#lymphocytes_path <- paste0(mapped_ai_output_dir, img_frag_muc, "_lymphocyte_centroids.geojson")
#lymphocytes <- st_read(lymphocytes_path, quiet = TRUE) %>% st_set_crs(0)
#lymphocyte_distances <- calculate_lymphocyte_distances(ai_output, lymphocytes, pixel_length_um)
#write_json(lymphocyte_distances, paste0(output_dir, "/lymphocyte_distances/", img_frag_muc, "_lymphocyte_distances.json"), pretty = TRUE)
lymphocyte_distances <- fromJSON(paste0(output_dir, "/lymphocyte_distances/", img_frag_muc, "_lymphocyte_distances.json"))
#lymphocyte_variables_to_plot <- c("measured_area_um2", "closest_junction_um",  "closest_neighbor_um", "log_closest_junction_um", "log_closest_neighbor_um")
#lymphocyte_clusters <- generate_lymphocyte_clusters(lymphocytes, pixel_length_um, dbscan_eps_um = 7, dbscan_minPts = 3, buffer_um = 4)
#lymphocyte_cluster_distances <- calculate_lymphocyte_distances(ai_output, lymphocyte_clusters, pixel_length_um)
#st_write(lymphocyte_clusters, paste0(output_dir, "lymphocyte_clusters/", img_frag_muc, "_lymphocyte_clusters.geojson"), quiet = TRUE, delete_dsn = TRUE)
#write_json(lymphocyte_cluster_distances, paste0(output_dir,"lymphocyte_clusters/", img_frag_muc, "_lymphocyte_cluster_distances.json"), pretty = TRUE)
lymphocyte_cluster_distances <- fromJSON(paste0(output_dir,"lymphocyte_clusters/", img_frag_muc, "_lymphocyte_cluster_distances.json"))
lymphocyte_features_summary <- summarize_lymphocyte_features(ai_output, lymphocyte_distances, lymphocyte_cluster_distances, pixel_area_um2)
lymphocyte_features_summaries <- bind_rows(lymphocyte_features_summaries, lymphocyte_features_summary)
}
write_json(lymphocyte_features_summaries, paste0(output_dir, "feature_summaries/lymphocyte_feature_summaries_labl_2020_tuning_included_fragments_new.json"), pretty = TRUE)
paste0(output_dir, "feature_summaries/lymphocyte_feature_summaries_labl_2020_tuning_included_fragments_new.json")
